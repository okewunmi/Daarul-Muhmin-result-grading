# Copy to .env.local for local development. On Netlify, add the same names under
# Site configuration -> Environment variables. NEVER commit real values.

# Neon: Project dashboard -> Connect -> copy the connection string
DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Any long random text (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Leave unset normally: the first account can always be created,
# after that new accounts must be created by a logged-in user.
# Set to true only while you want anyone to be able to register.
# ALLOW_REGISTRATION=true


